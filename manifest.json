{
  "manifest_version": 3,
  "name": "AMI Parts Bridge",
  "version": "0.3.10",
  "description": "Chrome side panel that mirrors NAPA / O'Reilly carts and WebEst estimate lines, then transfers them into AMI Shop CRM job cards.",
  "permissions": ["storage", "tabs", "sidePanel"],
  "host_permissions": [
    "http://localhost:5173/*",
    "http://localhost:8787/*",
    "http://127.0.0.1:5173/*",
    "http://127.0.0.1:8787/*",
    "https://shop.amitowing.com/*",
    "https://www.firstcallonline.com/*",
    "https://firstcallonline.com/*",
    "https://*.firstcallonline.com/*",
    "https://*.oreillyauto.com/*",
    "https://pro.napaprolink.com/*",
    "https://*.napaprolink.com/*",
    "https://proestimator.web-est.com/*",
    "https://*.web-est.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "AMI Parts Bridge - open side panel"
  },
  "side_panel": {
    "default_path": "sidepanel/index.html"
  },
  "web_accessible_resources": [
    {
      "resources": ["icons/*", "content/page-network-hook.js"],
      "matches": [
        "https://www.firstcallonline.com/*",
        "https://firstcallonline.com/*",
        "https://*.firstcallonline.com/*",
        "https://*.oreillyauto.com/*",
        "https://pro.napaprolink.com/*",
        "https://*.napaprolink.com/*",
        "https://proestimator.web-est.com/*",
        "https://*.web-est.com/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "http://localhost:5173/*",
        "http://127.0.0.1:5173/*",
        "https://shop.amitowing.com/*"
      ],
      "js": ["content/safe-chrome.js", "content/crm-bridge.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.firstcallonline.com/*",
        "https://firstcallonline.com/*",
        "https://*.firstcallonline.com/*",
        "https://*.oreillyauto.com/*"
      ],
      "js": [
        "content/safe-chrome.js",
        "content/oreilly-cart.js",
        "content/supplier-bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://pro.napaprolink.com/*",
        "https://*.napaprolink.com/*"
      ],
      "js": [
        "content/safe-chrome.js",
        "content/napa-hash-strip.js",
        "content/napa-cart.js",
        "content/supplier-bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://proestimator.web-est.com/*",
        "https://*.web-est.com/*"
      ],
      "js": ["content/page-network-hook.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": [
        "https://proestimator.web-est.com/*",
        "https://*.web-est.com/*"
      ],
      "js": [
        "content/safe-chrome.js",
        "content/webest-cart.js",
        "content/supplier-bridge.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
